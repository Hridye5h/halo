# Copy to server/.env and fill in for anything other than local development.
# Every value below has a working default in development — the server only
# *requires* them when NODE_ENV=production.

NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Leave empty to boot an in-process MongoDB (no install needed, not persisted).
# Set it to persist data — MongoDB Atlas has a free tier.
MONGO_URI=

# Generate each with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# In development these are randomised per process, which means a restart
# invalidates existing sessions. That is why production refuses to start without them.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
SOCKET_TICKET_SECRET=
IDENTITY_PEPPER=

UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=209715200
